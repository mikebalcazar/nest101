+  }[motivo] || {
+    titulo: `${nombre} no pudo abrir`,
+    detalle: "No pasó la revisión de licencia y no se sabe por qué.",
+  };
+  return { titulo: t.titulo, detalle: [t.detalle, detalle, donde].filter(Boolean).join("\n\n") };
+}
