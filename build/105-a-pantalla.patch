+/* ============================================================ #105 · unidades
+   Mike, 11-oct-2026: «un menú de configuración donde se puedan ajustar los
+   varios parámetros de la aplicación… el idioma, las unidades, etc».
+
+   Él escogió el alcance: las unidades cambian **sólo lo que se lee en la
+   pantalla donde se diseña** —las cotas del dibujo y las medidas de la
+   parrilla—. El programa calcula, nesta y cotiza en milímetros siempre, y la
+   lista de corte, los planos y el DXF se quedan en milímetros a propósito:
+   son los que van a la máquina y al carpintero, y una pantalla en pulgadas
+   junto a un papel en milímetros es una hoja echada a perder.
+
+   Las pulgadas se escriben en quebrados de dieciseisavo —35 7/16"— porque así
+   están marcadas las cintas. Un «35.433"» no se puede medir.
+
+   Hasta aquí las cotas estaban en centímetros a fuerza (#022). Quien no toque
+   nada ahora las ve en milímetros, que es lo que trae el archivo; el taller
+   que las quiera en centímetros lo dice una vez en Ajustes. */
+const UNI = {
+  mm:   { nom: "Milímetros", corto: "mm",  ej: "880 mm" },
+  cm:   { nom: "Centímetros", corto: "cm", ej: "88 cm" },
+  pulg: { nom: "Pulgadas", corto: '"',     ej: '34 5/8"' },
+};
+const U = {
+  cual: () => (UNI[S.unidades] ? S.unidades : "mm"),
+  corto: () => UNI[U.cual()].corto,
+
+  /** El número solo, como se teclea en la cajita de la cota. */
+  valor(mm) {
+    const u = U.cual();
+    if (u === "mm") return String(Math.round(mm * 10) / 10).replace(/\.0$/, "");
+    if (u === "cm") return String(Math.round(mm) / 10).replace(/\.0$/, "");
+    return U.quebrado(mm / 25.4);
+  },
+
+  /** El número con su unidad, para leer. */
+  texto(mm) {
+    const u = U.cual();
+    if (u === "pulg") return U.quebrado(mm / 25.4) + '"';
+    return U.valor(mm) + " " + UNI[u].corto;
+  },
+
+  /** Pulgadas a quebrado de dieciseisavo: 902 mm → «35 1/2». */
+  quebrado(p) {
+    const n = Math.round(p * 16);
+    const ent = Math.trunc(n / 16);
+    let num = Math.abs(n % 16), den = 16;
+    while (num && num % 2 === 0) { num /= 2; den /= 2; }
+    if (!num) return String(ent);
+    return (ent ? ent + " " : (n < 0 ? "-" : "")) + num + "/" + den;
+  },
+
+  /** De lo que se tecleó, a milímetros. Acepta «35 7/16», «35-7/16», «35.5».
+   *  Devuelve NaN si no se entiende, para que quien llama no aplique nada. */
+  aMm(txt) {
+    const u = U.cual();
+    const s = String(txt).trim().replace(/["”]/g, "").replace(/\s*-\s*/, " ");
+    if (!s) return NaN;
+    let v = NaN;
+    const q = s.match(/^(\d+(?:\.\d+)?)?\s*(\d+)\s*\/\s*(\d+)$/);
+    if (q) {
+      const d = parseFloat(q[3]);
+      v = (parseFloat(q[1] || "0")) + (d ? parseFloat(q[2]) / d : NaN);
+    } else {
+      v = parseFloat(s.replace(",", "."));
+    }
+    if (!isFinite(v)) return NaN;
+    return u === "mm" ? v : u === "cm" ? v * 10 : v * 25.4;
+  },
+
+  /** Cuánto salta la flechita del teclado. En pulgadas no hay flechita: se
+   *  teclea el quebrado, así que la cajita es de texto. */
+  paso: () => ({ mm: "1", cm: "0.1", pulg: "any" })[U.cual()],
+  tecleo: () => (U.cual() === "pulg" ? "text" : "number"),
+};
+/** Se conserva el nombre viejo: lo usan las cuatro cotas de #022. */
+const cm = (mm) => U.texto(mm);
+
+/** «90 × 88 × 60 cm» — las tres medidas de la parrilla, en la unidad del
+ *  taller y con la unidad escrita una sola vez. Es `function` y no `const`
+ *  porque la parrilla se pinta desde arriba del archivo. */
+function medidas(a, b, c) {
+  // En pulgadas la marca va pegada a cada número —35 7/16" × 34 5/8"— porque
+  // una sola comilla al final, después de tres quebrados, no se lee.
+  if (U.cual() === "pulg") return [a, b, c].map(U.texto).join(" × ");
+  return `${U.valor(a)} × ${U.valor(b)} × ${U.valor(c)} ${U.corto()}`;
+}
 
